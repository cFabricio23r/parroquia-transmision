<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <!-- Servicio en primer plano camera|microphone: sigue al aire en segundo plano y con la pantalla apagada (Tarea 1, punto 7). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <!-- La notificación fija del servicio (Android 13 o más pide permiso). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="org.parroquiaarce.transmisor.ServicioTransmision"
      android:exported="false"
      android:foregroundServiceType="camera|microphone" />
  </application>
</manifest>
