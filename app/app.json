{
  "expo": {
    "name": "Parroquia en vivo",
    "slug": "parroquia-en-vivo",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icono/icono.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c3562",
        "foregroundImage": "./assets/icono/frente.png",
        "backgroundImage": "./assets/icono/fondo.png",
        "monochromeImage": "./assets/icono/monocromo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.parroquiaarce.envivo",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c3562",
          "image": "./assets/portada/logo-blanco.png",
          "imageWidth": 150
        }
      ]
    ]
  }
}
